# --- Required ---
DATABASE_URL=mysql://user:password@host:3306/dbname
JWT_SECRET=                 # 32+ random characters (signs staff login cookies)
ADMIN_EMAIL=                # staff login email
ADMIN_PASSWORD_HASH=        # run: pnpm hash-password "your password"
# Optional extra staff logins (JSON): [{"email":"a@b.com","hash":"scrypt$..."}]
STAFF_ACCOUNTS=
CRON_SECRET=                # 16+ random characters; Vercel Cron sends it automatically

# --- Meta (Facebook / Instagram) ---
META_APP_SECRET=
META_VERIFY_TOKEN=
META_SEND_ENABLED=false     # set true only after the preview checks pass
# (keep the other META_* / BROWSER_USE_* variables exactly as they are in Manus today)
